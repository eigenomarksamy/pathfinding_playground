---
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Regroup
IncludeCategories:
  # the engine's own headers, then third-party ones, then the standard library
  - Regex: '^"pathfinding/'
    Priority: 1
  - Regex: '^<(gtest|emscripten)/'
    Priority: 2
  - Regex: '^<'
    Priority: 3
